{
  "name": "@kinetographdev/compat",
  "version": "0.2.0",
  "description": "Remotion compat mode: DOM islands handed to the Rust CSS engine, and the DOM shim for refs and browser globals (packages/cli/skills/kinetograph/references/ENGINE.md, /docs/compat/)",
  "license": "PolyForm-Small-Business-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xS4N4TG/kinetograph.git",
    "directory": "packages/compat"
  },
  "homepage": "https://github.com/0xS4N4TG/kinetograph#readme",
  "bugs": {
    "url": "https://github.com/0xS4N4TG/kinetograph/issues"
  },
  "keywords": [
    "video",
    "remotion",
    "motion-graphics",
    "renderer",
    "gpu",
    "headless"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shim": {
      "types": "./dist/shim/index.d.ts",
      "default": "./dist/shim/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "default": "./dist/doctor.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kinetographdev/scene": "0.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
