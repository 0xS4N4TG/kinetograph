{
  "name": "@kinetograph/compat",
  "version": "0.1.0",
  "description": "Remotion compat mode: DOM elements and inline CSS mapped onto Kinetograph layers, and the Chrome fallback (docs/COMPAT.md)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./css": { "types": "./dist/css/index.d.ts", "default": "./dist/css/index.js" },
    "./dom": { "types": "./dist/dom/index.d.ts", "default": "./dist/dom/index.js" },
    "./browser": { "types": "./dist/browser/index.d.ts", "default": "./dist/browser/index.js" },
    "./doctor": { "types": "./dist/doctor.d.ts", "default": "./dist/doctor.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kinetograph/scene": "0.1.0"
  }
}
