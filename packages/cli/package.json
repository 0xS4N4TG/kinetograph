{
  "name": "kinetograph",
  "version": "0.2.5",
  "description": "Agent CLI and MCP server for the Kinetograph video engine: renders Remotion projects, HTML pages and HyperFrames projects without a browser",
  "license": "PolyForm-Small-Business-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xS4N4TG/kinetograph.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/0xS4N4TG/kinetograph#readme",
  "bugs": {
    "url": "https://github.com/0xS4N4TG/kinetograph/issues"
  },
  "keywords": [
    "video",
    "remotion",
    "motion-graphics",
    "renderer",
    "gpu",
    "headless",
    "hyperframes",
    "html",
    "gsap"
  ],
  "type": "module",
  "bin": {
    "kinetograph": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kinetographdev/audio": "0.2.5",
    "@kinetographdev/compat": "0.2.5",
    "@kinetographdev/core": "0.2.5",
    "@kinetographdev/native": "0.2.5",
    "@kinetographdev/scene": "0.2.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2",
    "parse5": "8.0.1",
    "postcss": "8.5.30",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "gsap": "3.14.2"
  }
}
