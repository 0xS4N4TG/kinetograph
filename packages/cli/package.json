{
  "name": "kinetograph",
  "version": "0.1.0",
  "description": "Agent CLI and MCP server for the Kinetograph video engine",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "bin": {
    "kinetograph": "dist/cli.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "skill", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kinetograph/audio": "0.1.0",
    "@kinetograph/core": "0.1.0",
    "@kinetograph/native": "0.1.0",
    "@kinetograph/scene": "0.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  }
}
