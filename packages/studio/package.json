{
  "name": "@kinetographdev/studio",
  "version": "0.2.5",
  "description": "kinetograph studio: a local web server and browser UI whose preview frames the addon renders",
  "license": "PolyForm-Small-Business-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xS4N4TG/kinetograph.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/0xS4N4TG/kinetograph#readme",
  "bugs": {
    "url": "https://github.com/0xS4N4TG/kinetograph/issues"
  },
  "keywords": [
    "video",
    "remotion",
    "motion-graphics",
    "renderer",
    "gpu",
    "headless"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "ui/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.2",
    "@kinetographdev/core": "0.2.5",
    "@kinetographdev/native": "0.2.5",
    "@kinetographdev/scene": "0.2.5",
    "kinetograph": "0.2.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.2"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
