{
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "durationInFrames": 60,
  "background": "#efe4cf",
  "fonts": { "DM Sans": "../assets/fonts/DMSans-Medium.ttf" },
  "layers": [
    {
      "id": "paper-glow",
      "type": "shape",
      "shape": { "kind": "ellipse", "width": 1500, "height": 2300 },
      "fill": "#fbf5e8",
      "transform": { "x": -210, "y": -190 },
      "effects": [{ "type": "blur", "radius": 120 }]
    },
    {
      "id": "card-group",
      "type": "group",
      "opacity": [
        { "frame": 0, "value": 0, "easing": "easeOut" },
        { "frame": 16, "value": 1 }
      ],
      "transform": {
        "y": [
          { "frame": 0, "value": 70, "easing": "easeOut" },
          { "frame": 24, "value": 0 }
        ]
      },
      "children": [
        {
          "id": "shadow-far",
          "type": "shape",
          "shape": { "kind": "roundedRect", "width": 880, "height": 1280, "radius": 56 },
          "fill": "#3b2a1a59",
          "transform": { "x": 100, "y": 372 },
          "effects": [{ "type": "blur", "radius": 44 }]
        },
        {
          "id": "shadow-near",
          "type": "shape",
          "shape": { "kind": "roundedRect", "width": 880, "height": 1280, "radius": 56 },
          "fill": "#2a1c1073",
          "transform": { "x": 100, "y": 334 },
          "effects": [{ "type": "blur", "radius": 10 }]
        },
        {
          "id": "card",
          "type": "shape",
          "shape": { "kind": "roundedRect", "width": 880, "height": 1280, "radius": 56 },
          "fill": "#fffdf8",
          "transform": { "x": 100, "y": 320 }
        },
        {
          "id": "art",
          "type": "image",
          "src": "card-art.png",
          "width": 800,
          "height": 600,
          "transform": { "x": 140, "y": 360 }
        },
        {
          "id": "kicker",
          "type": "text",
          "text": "ISSUE 04  /  PAPER CUT",
          "font": "DM Sans",
          "size": 30,
          "color": "#c4572e",
          "transform": { "x": 140, "y": 1010 }
        },
        {
          "id": "title",
          "type": "text",
          "text": "Paper cut stories, rendered on the GPU with no browser",
          "font": "DM Sans",
          "size": 84,
          "color": "#2b2118",
          "lineHeight": 1.1,
          "maxWidth": 800,
          "transform": { "x": 140, "y": 1070 }
        },
        {
          "id": "subtitle",
          "type": "text",
          "text": "One Rust binary, a scene graph, and a compositor that blends in linear light.",
          "font": "DM Sans",
          "size": 36,
          "color": "#8a7355",
          "lineHeight": 1.3,
          "maxWidth": 800,
          "transform": { "x": 140, "y": 1480 }
        },
        {
          "id": "sticker",
          "type": "shape",
          "shape": { "kind": "ellipse", "width": 150, "height": 150 },
          "fill": "#e4572e",
          "transform": { "x": 810, "y": 292 }
        },
        {
          "id": "sticker-star",
          "type": "shape",
          "shape": {
            "kind": "path",
            "d": "M0 -40 L12 -12 L42 -12 L18 8 L26 38 L0 20 L-26 38 L-18 8 L-42 -12 L-12 -12 Z"
          },
          "fill": "#fffdf8",
          "transform": {
            "x": 885,
            "y": 367,
            "rotation": [
              { "frame": 0, "value": -25, "easing": "easeInOut" },
              { "frame": 59, "value": 25 }
            ]
          }
        }
      ]
    },
    {
      "id": "grain",
      "type": "image",
      "src": "grain.png",
      "width": 1080,
      "height": 1920,
      "blendMode": "multiply"
    }
  ]
}
