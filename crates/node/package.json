{
  "name": "@kinetograph/native",
  "version": "0.1.0",
  "description": "Node-API addon exposing the Kinetograph renderer",
  "license": "MIT OR Apache-2.0",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": ["index.js", "index.d.ts", "*.node"],
  "napi": {
    "binaryName": "kinetograph",
    "targets": ["aarch64-apple-darwin", "x86_64-unknown-linux-gnu"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "napi build --platform",
    "build:release": "napi build --platform --release",
    "test": "node --test \"test/*.test.cjs\""
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.8"
  }
}
