{
  "width": 320,
  "height": 240,
  "fps": 30,
  "durationInFrames": 30,
  "background": "#d9d2c3",
  "fonts": { "DM Sans": "../../../../assets/fonts/DMSans-Medium.ttf" },
  "layers": [
    { "id": "corner", "type": "shape",
      "shape": { "kind": "roundedRect", "width": 90, "height": 60, "radius": 10 },
      "fill": "#3d6cb9",
      "effects": [{ "type": "insetShadow",
        "x": [{ "frame": 0, "value": -2 }, { "frame": 30, "value": 3 }],
        "y": [{ "frame": 0, "value": 1.5 }, { "frame": 30, "value": -1.5 }],
        "blur": 0, "color": "#000000a0" }] },

    { "id": "turned", "type": "shape",
      "shape": { "kind": "rect", "width": 70, "height": 50 },
      "fill": "#ff880080",
      "transform": { "x": 140, "y": 40, "rotation": 17, "anchorX": 35, "anchorY": 25 },
      "effects": [{ "type": "insetShadow", "x": 3, "y": 3, "blur": 0, "color": "#201060ff" }] },

    { "id": "triangle", "type": "shape",
      "shape": { "kind": "path", "d": "M20 120 L90 118 L50 180 Z" },
      "fill": { "type": "linear", "x0": 20, "y0": 120, "x1": 90, "y1": 180,
                "stops": [{ "offset": 0, "color": "#f4d35e" }, { "offset": 1, "color": "#ee6c4d" }] },
      "effects": [{ "type": "insetShadow", "x": -1.5, "y": 2.25, "blur": 0, "color": "#000000c0" }] },

    { "id": "ring", "type": "shape",
      "shape": { "kind": "ellipse", "width": 80, "height": 60 },
      "fill": { "type": "radial", "cx": 40, "cy": 30, "r": 40,
                "stops": [{ "offset": 0, "color": "#ffffff" }, { "offset": 1, "color": "#4cb5ae" }] },
      "stroke": { "color": "#1b4332", "width": 5 },
      "transform": { "x": 120, "y": 120 },
      "effects": [{ "type": "insetShadow", "x": 2, "y": 2, "blur": 0, "color": "#00000080" }] },

    { "id": "word", "type": "text", "text": "Inset", "font": "DM Sans", "size": 40,
      "color": "#2b2d42", "transform": { "x": 20, "y": 190 },
      "effects": [{ "type": "insetShadow", "x": 1, "y": 1.5, "blur": 0, "color": "#ffffffc0" }] },

    { "id": "far-corner", "type": "shape",
      "shape": { "kind": "rect", "width": 120, "height": 70 },
      "fill": "#8338ec",
      "transform": { "x": 220, "y": 190 },
      "effects": [{ "type": "insetShadow", "x": -3, "y": -3, "blur": 0, "color": "#ffffff90" }] },

    { "id": "off-left", "type": "shape",
      "shape": { "kind": "roundedRect", "width": 80, "height": 40, "radius": 6 },
      "fill": "#2a9d8f",
      "transform": { "x": -30, "y": 90 },
      "effects": [{ "type": "insetShadow", "x": 4, "y": 0, "blur": 0, "color": "#000000ff" }] }
  ]
}
