{
  "width": 480,
  "height": 270,
  "fps": 30,
  "durationInFrames": 30,
  "background": "#14161d",
  "fonts": { "DM Sans": "../../../../assets/fonts/DMSans-Medium.ttf" },
  "layers": [
    { "id": "wave", "type": "text", "text": "Kinetic", "font": "DM Sans", "size": 56, "color": "#ffffff",
      "transform": { "x": 20, "y": 14 },
      "chars": [
        { "y": [{ "frame": 0, "value": 40 }, { "frame": 20, "value": 0 }], "opacity": [{ "frame": 0, "value": 0 }, { "frame": 10, "value": 1 }] },
        { "y": [{ "frame": 2, "value": 40 }, { "frame": 22, "value": 0 }], "opacity": [{ "frame": 2, "value": 0 }, { "frame": 12, "value": 1 }] },
        { "y": [{ "frame": 4, "value": 40 }, { "frame": 24, "value": 0 }], "opacity": [{ "frame": 4, "value": 0 }, { "frame": 14, "value": 1 }] },
        { "y": [{ "frame": 6, "value": 40 }, { "frame": 26, "value": 0 }], "opacity": [{ "frame": 6, "value": 0 }, { "frame": 16, "value": 1 }] },
        { "y": [{ "frame": 8, "value": 40 }, { "frame": 28, "value": 0 }], "opacity": [{ "frame": 8, "value": 0 }, { "frame": 18, "value": 1 }] },
        { "y": [{ "frame": 10, "value": 40 }, { "frame": 30, "value": 0 }], "opacity": [{ "frame": 10, "value": 0 }, { "frame": 20, "value": 1 }] },
        { "y": [{ "frame": 12, "value": 40 }, { "frame": 32, "value": 0 }], "opacity": [{ "frame": 12, "value": 0 }, { "frame": 22, "value": 1 }] }
      ] },

    { "id": "pop", "type": "text", "text": "gets better", "font": "DM Sans", "size": 44,
      "color": { "type": "linear", "units": "box", "x0": 0, "y0": 0, "x1": 1, "y1": 0,
                 "stops": [{ "offset": 0, "color": "#ff99aa" }, { "offset": 1, "color": "#ffcc66" }] },
      "transform": { "x": 20, "y": 90 },
      "chars": [
        { "scale": 1.6, "rotation": -12 },
        { "scale": 0.4, "rotation": 30 },
        null,
        { "scale": 1.3, "rotation": 8 },
        null,
        { "scale": 0.7 },
        null,
        { "rotation": 180, "scale": 1.2 },
        { "x": 3, "y": -6 },
        null,
        { "scale": 1.5, "rotation": 14, "color": "#7aa2f7" }
      ] },

    { "id": "lines", "type": "text", "text": "two\nlines here", "font": "DM Sans", "size": 30,
      "color": "#f6c177", "align": "center", "maxWidth": 220, "transform": { "x": 20, "y": 160 },
      "chars": [
        { "color": "#06d6a0" },
        null,
        { "opacity": 0.4 },
        { "y": 99, "x": 99, "scale": 9, "opacity": 0 },
        { "scale": 1.4, "rotation": -10 },
        { "rotation": 20 },
        null,
        { "y": 6 },
        null,
        { "color": "#ef476f" },
        { "color": "#ef476f", "scale": 0.8 },
        { "x": [{ "frame": 0, "value": 0 }, { "frame": 30, "value": 10 }] }
      ] },

    { "id": "shadowed", "type": "text", "text": "Glow", "font": "DM Sans", "size": 60,
      "color": "#ffffff", "transform": { "x": 300, "y": 150 },
      "effects": [{ "type": "dropShadow", "x": 0, "y": 6, "blur": 6, "color": "#000000cc" }],
      "chars": [
        { "y": -10, "rotation": -8 },
        { "y": 10, "scale": 0.9 },
        { "y": -10, "rotation": 8 },
        { "y": 10, "scale": 1.1 }
      ] }
  ]
}
