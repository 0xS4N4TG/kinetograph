{
 "width": 480,
 "height": 270,
 "fps": 30,
 "durationInFrames": 30,
 "background": "#14161d",
 "fonts": {
  "DM Sans": "../../../../assets/fonts/DMSans-Medium.ttf"
 },
 "camera": {
  "perspective": 700
 },
 "layers": [
  {
   "id": "bg",
   "type": "shape",
   "shape": {
    "kind": "rect",
    "width": 480,
    "height": 270
   },
   "fill": {
    "type": "linear",
    "x0": 0,
    "y0": 0,
    "x1": 0,
    "y1": 270,
    "stops": [
     {
      "offset": 0,
      "color": "#1f2638"
     },
     {
      "offset": 1,
      "color": "#0d0f15"
     }
    ]
   }
  },
  {
   "id": "whip",
   "type": "group",
   "transform": {
    "x": [
     {
      "frame": 0,
      "value": -300,
      "easing": "easeInOut"
     },
     {
      "frame": 30,
      "value": 560
     }
    ],
    "y": 30
   },
   "motionBlur": {
    "samples": 12,
    "shutter": [
     {
      "frame": 0,
      "value": 0.2
     },
     {
      "frame": 30,
      "value": 1.6
     }
    ]
   },
   "children": [
    {
     "id": "whip-card",
     "type": "shape",
     "shape": {
      "kind": "roundedRect",
      "width": 170,
      "height": 56,
      "radius": 10
     },
     "fill": "#ef476f",
     "effects": [
      {
       "type": "dropShadow",
       "x": 6,
       "y": 8,
       "blur": 6,
       "color": "#00000099"
      }
     ]
    },
    {
     "id": "whip-text",
     "type": "text",
     "text": "WHIP",
     "font": "DM Sans",
     "size": 38,
     "color": "#ffffff",
     "transform": {
      "x": 28,
      "y": 8
     }
    }
   ]
  },
  {
   "id": "fan",
   "type": "group",
   "opacity": 0.9,
   "transform": {
    "x": 430,
    "y": 175,
    "rotation": [
     {
      "frame": 0,
      "value": 0
     },
     {
      "frame": 30,
      "value": 600
     }
    ]
   },
   "motionBlur": {
    "samples": 16,
    "shutter": 1
   },
   "children": [
    {
     "id": "spoke-0",
     "type": "shape",
     "shape": {
      "kind": "rect",
      "width": 150,
      "height": 10
     },
     "fill": "#ffd166",
     "transform": {
      "anchorX": 75,
      "anchorY": 5,
      "rotation": 0
     }
    },
    {
     "id": "spoke-1",
     "type": "shape",
     "shape": {
      "kind": "rect",
      "width": 150,
      "height": 10
     },
     "fill": "#06d6a0",
     "transform": {
      "anchorX": 75,
      "anchorY": 5,
      "rotation": 60
     }
    },
    {
     "id": "spoke-2",
     "type": "shape",
     "shape": {
      "kind": "rect",
      "width": 150,
      "height": 10
     },
     "fill": "#118ab2",
     "transform": {
      "anchorX": 75,
      "anchorY": 5,
      "rotation": 120
     }
    }
   ]
  },
  {
   "id": "flash",
   "type": "shape",
   "shape": {
    "kind": "ellipse",
    "width": 70,
    "height": 70
   },
   "fill": "#06d6a0",
   "transform": {
    "x": 15,
    "y": 180
   },
   "opacity": [
    {
     "frame": 0,
     "value": 0
    },
    {
     "frame": 14,
     "value": 0
    },
    {
     "frame": 16,
     "value": 1
    },
    {
     "frame": 30,
     "value": 1
    }
   ],
   "motionBlur": {
    "samples": 8,
    "shutter": 2
   }
  },
  {
   "id": "photo",
   "type": "image",
   "src": "../../../../examples/card-art.png",
   "width": 120,
   "height": 80,
   "transform": {
    "x": [
     {
      "frame": 0,
      "value": 70
     },
     {
      "frame": 30,
      "value": 170
     }
    ],
    "y": 105
   },
   "matte": {
    "layer": "cutter"
   },
   "motionBlur": {
    "samples": 8,
    "shutter": 1
   }
  },
  {
   "id": "cutter",
   "type": "shape",
   "shape": {
    "kind": "ellipse",
    "width": 100,
    "height": 60
   },
   "fill": "#ffffff",
   "transform": {
    "x": [
     {
      "frame": 0,
      "value": 80
     },
     {
      "frame": 30,
      "value": 200
     }
    ],
    "y": 115
   },
   "motionBlur": {
    "samples": 8,
    "shutter": 1
   }
  },
  {
   "id": "spin",
   "type": "image",
   "src": "../../../../examples/card-art.png",
   "width": 90,
   "height": 68,
   "transform": {
    "x": 255,
    "y": 225,
    "anchorX": 45,
    "anchorY": 34,
    "rotateY": [
     {
      "frame": 0,
      "value": 0
     },
     {
      "frame": 30,
      "value": 600
     }
    ],
    "z": 30
   },
   "motionBlur": {
    "samples": 12,
    "shutter": 1
   }
  },
  {
   "id": "shut",
   "type": "shape",
   "shape": {
    "kind": "rect",
    "width": 30,
    "height": 30
   },
   "fill": "#ffd166",
   "transform": {
    "x": [
     {
      "frame": 0,
      "value": 20
     },
     {
      "frame": 30,
      "value": 70
     }
    ],
    "y": 100,
    "rotation": [
     {
      "frame": 0,
      "value": 0
     },
     {
      "frame": 30,
      "value": 90
     }
    ]
   },
   "motionBlur": {
    "samples": 8,
    "shutter": 0
   }
  },
  {
   "id": "stay",
   "type": "text",
   "text": "STILL",
   "font": "DM Sans",
   "size": 22,
   "color": "#ffffff",
   "transform": {
    "x": 20,
    "y": 145
   },
   "motionBlur": {
    "samples": 4,
    "shutter": 1
   }
  }
 ]
}
