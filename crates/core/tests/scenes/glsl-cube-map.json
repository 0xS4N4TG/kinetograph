{"width": 256, "height": 256, "fps": 30, "durationInFrames": 1, "background": "#000000", "blendSpace": "linear", "layers": [{"id": "sky", "type": "glsl", "width": 256, "height": 256, "programs": {"p": {"vertex": "attribute vec2 a_pos; varying vec2 v_uv; void main(){ v_uv=a_pos; gl_Position=vec4(a_pos,0.0,1.0); }", "fragment": "precision highp float; varying vec2 v_uv; uniform samplerCube u_env;\nvoid main(){\n  vec3 ro = vec3(0.0, 0.0, 3.0);\n  vec3 rd = normalize(vec3(v_uv * 0.6, -1.0));\n  vec3 c = textureCube(u_env, rd).rgb;\n  float b = dot(ro, rd);\n  float h = b*b - (dot(ro, ro) - 1.0);\n  if (h > 0.0) {\n    float t = -b - sqrt(h);\n    vec3 p = ro + rd * t;\n    vec3 n = normalize(p);\n    vec3 r = reflect(rd, n);\n    float fres = 0.15 + 0.85 * pow(1.0 - max(dot(-rd, n), 0.0), 3.0);\n    c = mix(vec3(0.05), textureCube(u_env, r).rgb, 0.4 + 0.6 * fres);\n  }\n  gl_FragColor = vec4(c, 1.0);\n}", "attributes": {"a_pos": 0}}}, "buffers": {"quad": "AACAvwAAgL8AAIA/AACAvwAAgL8AAIA/AACAvwAAgD8AAIA/AACAvwAAgD8AAIA/"}, "textures": {"env": {"cube": true, "width": 32, "height": 32, "mipmaps": true, "faces": [{"pixels": ""}, {"pixels": ""}, {"pixels": ""}, {"pixels": ""}, {"pixels": ""}, {"pixels": ""}]}}, "ops": [{"op": "draw", "program": "p", "mode": "triangles", "first": 0, "count": 6, "attributes": {"a_pos": {"buffer": "quad", "size": 2, "type": "f32", "normalized": false, "stride": 0, "offset": 0}}, "viewport": [0, 0, 256, 256], "uniforms": {"u_env": [{"kind": "i", "value": [0]}]}, "units": {"0": {"texture": "env", "min": "LINEAR_MIPMAP_LINEAR", "mag": "LINEAR"}}}]}]}